rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Schema v2 recipe (docs/IMPLEMENTATION_PLAN.md, Appendix A): ingredients are an inline array,
    // OwnerId is the writer's uid and can't change, and only known fields are allowed.
    function validRecipe() {
      let d = request.resource.data;
      return d.keys().hasOnly(['Name', 'Instructions', 'Ingredients', 'Servings', 'OwnerId', 'OwnerName',
          'IsShared', 'SourceRecipePath', 'ImagePath', 'CreatedAt', 'UpdatedAt'])
        && d.Name is string && d.Name.size() > 0 && d.Name.size() <= 200
        && d.Instructions is string && d.Instructions.size() <= 20000
        && d.Ingredients is list && d.Ingredients.size() <= 100
        && d.OwnerId == request.auth.uid
        && d.IsShared is bool
        && (!('Servings' in d) || (d.Servings is int && d.Servings >= 1 && d.Servings <= 100))
        && (!('OwnerName' in d) || (d.OwnerName is string && d.OwnerName.size() <= 100))
        && (!('SourceRecipePath' in d) || (d.SourceRecipePath is string && d.SourceRecipePath.size() <= 200))
        && (!('ImagePath' in d) || (d.ImagePath is string && d.ImagePath.size() <= 200));
    }

    // Pantry and shopping-list items: the document ID is the normalised ingredient key (computed in the
    // app); the document holds the display name and, for the shopping list, optional amount details.
    // A day in the meal plan: the document ID is the date (yyyy-MM-dd), repeated in `Date`, with that day's meals.
    function validPlanDay(date) {
      let d = request.resource.data;
      return date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.keys().hasOnly(['Date', 'Meals', 'UpdatedAt'])
        && d.Date == date
        && d.Meals is list && d.Meals.size() <= 20;
    }

    function validListItem() {
      let d = request.resource.data;
      return d.keys().hasOnly(['Name', 'Quantity', 'Unit', 'Note', 'CreatedAt'])
        && d.Name is string && d.Name.size() > 0 && d.Name.size() <= 100
        && (!('Quantity' in d) || d.Quantity is number)
        && (!('Unit' in d) || (d.Unit is string && d.Unit.size() <= 20))
        && (!('Note' in d) || (d.Note is string && d.Note.size() <= 200));
    }

    // The v1 global /Ingredients collection is retired (DEC-3): no rule, so every access is denied.
    // Ingredient attributes will live in a read-only Catalogue collection later.

    // Collection-group query for shared recipes: db.collectionGroup("Recipes")
    // .whereField("IsShared", ==, true) in DataManager.listenToSharedRecipes.
    // Rules v2 needs this declared with a recursive wildcard. Only shared recipes qualify.
    // (There is deliberately no collection-group rule for Ingredients: it would let any
    // signed-in user list every user's ingredient entries, including unshared recipes.)
    match /{path=**}/Recipes/{recipeId} {
      allow read: if signedIn() && resource.data.IsShared == true;
    }

    match /Users/{userId} {
      allow read, write: if isOwner(userId);

      match /Recipes/{recipeId} {
        allow read: if signedIn() && (request.auth.uid == userId || resource.data.IsShared == true);
        allow create: if isOwner(userId) && validRecipe();
        allow update: if isOwner(userId) && validRecipe() && resource.data.OwnerId == request.resource.data.OwnerId;
        allow delete: if isOwner(userId);
      }

      match /Pantry/{ingredientId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validListItem();
      }

      match /MealPlan/{date} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validPlanDay(date);
      }

      match /ShoppingList/{ingredientId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validListItem();
      }
    }
  }
}
